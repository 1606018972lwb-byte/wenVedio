# wenVedio 服务端环境配置示例 —— 复制为 .env 并填入真实值
PORT=8787
# 监听地址：127.0.0.1 仅本机可访问；要让客户端从别的机器连过来，改为 0.0.0.0
HOST=127.0.0.1
AUTODL_ENDPOINT=https://www.autodl.art/api/v1/comfyui/comfyui_workflow
AUTODL_WORKFLOW=minimax_h3_lightx2v_v5_15s
AUTODL_REQUEST_URL=https://www.autodl.art/api/v1/comfyui/comfyui_workflow/minimax_h3_lightx2v_v5_15s
AUTODL_QUERY_URL=https://www.autodl.art/api/v1/comfyui/comfyui_workflow/result/{task_id}
# 在 autodl 平台创建的 工作流 API Key（切勿提交）
AUTODL_API_KEY=your_workflow_api_key_here
# 可选：平台站内登录 token，填写后可在客户端查询任务结果
AUTODL_TASKS_TOKEN=
# 演示模式 true/false
MOCK=false
# 数据目录，默认项目根目录下的 data/
# WENVEDIO_DATA_DIR=
