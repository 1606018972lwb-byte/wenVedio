# wenVedio 环境配置示例 —— 复制为 .env 并填入真实值
PORT=8787
AUTODL_ENDPOINT=https://www.autodl.art/api/v1/comfyui/comfyui_workflow
AUTODL_WORKFLOW=minimax_h3_lightx2v_v5_15s
# 在 autodl 平台创建的 工作流 API Key（切勿提交）
AUTODL_API_KEY=your_workflow_api_key_here
# 可选：平台站内登录 token，填写后可在工作台查询任务结果
AUTODL_TASKS_TOKEN=
# 演示模式 true/false
MOCK=false
